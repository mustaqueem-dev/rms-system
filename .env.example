# ============================================================
# RMS Backend — Root Environment Variables
# Copy this file to .env and fill in the values for your env
# ============================================================

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── MongoDB ──────────────────────────────────────────────────
# Root connection string (auth/user prefix included in service-level URIs)
MONGO_ROOT_USERNAME=rms
MONGO_ROOT_PASSWORD=rms_secret
MONGODB_URI=mongodb://rms:rms_secret@localhost:27017

# Per-service database names
AUTH_DB_NAME=rms_auth
MENU_DB_NAME=rms_menu
INVENTORY_DB_NAME=rms_inventory
ORDERS_DB_NAME=rms_orders
TABLES_DB_NAME=rms_tables
STAFF_DB_NAME=rms_staff

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=rms-backend
KAFKA_GROUP_ID=rms-service

# ── JWT ───────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION — minimum 32 random characters
JWT_SECRET=dev-secret-change-in-prod-min-32-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ── API Gateway ────────────────────────────────────────────────
API_GATEWAY_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:3000

# Per-service URLs (used by API Gateway for proxying)
AUTH_SERVICE_URL=http://localhost:3004
MENU_SERVICE_URL=http://localhost:3001
INVENTORY_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
TABLE_SERVICE_URL=http://localhost:3007
STAFF_SERVICE_URL=http://localhost:3008
REPORTING_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3005

# ── Service Ports ──────────────────────────────────────────────
AUTH_SERVICE_PORT=3004
MENU_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
TABLE_SERVICE_PORT=3007
STAFF_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3005
REPORTING_SERVICE_PORT=3006

# ── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT_IP=1000
THROTTLE_LIMIT_USER=100

# ── Notifications ─────────────────────────────────────────────
# WhatsApp Business API (Twilio/Meta WABA) — leave empty in dev to skip
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
SMS_PROVIDER=twilio

# ── Reporting / Storage ───────────────────────────────────────
REPORTS_STORAGE=local
REPORTS_LOCAL_PATH=./uploads/reports
# AWS S3 (for staging/production)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REPORTS_BUCKET=

# ── Secrets Manager (production only) ────────────────────────
AWS_SECRETS_MANAGER_REGION=
