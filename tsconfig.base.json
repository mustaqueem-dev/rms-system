// tsconfig.base.json
{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@rms/shared-kernel": ["packages/shared-kernel/src/index.ts"],
      "@rms/shared-kernel/*": ["packages/shared-kernel/src/*"],
      "@rms/event-contracts": ["packages/event-contracts/src/index.ts"],
      "@rms/event-contracts/*": ["packages/event-contracts/src/*"]
    }
  }
}
