NODE_ENV=development
PORT=3006

# Redis (BullMQ queue backend)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB — point at the same cluster as order-service / inventory-service
# In production use a read replica (e.g. mongodb+srv:// with readPreference=secondary)
MONGO_URI=mongodb://localhost:27017/rms_orders

# Kafka
KAFKA_BROKERS=localhost:9092

# Where to write generated PDF reports
REPORTS_UPLOAD_DIR=./uploads/reports

# Reporting branch IDs — comma-separated (used by cron auto-dispatch)
REPORTING_BRANCHES=

# Logging
LOG_LEVEL=info
