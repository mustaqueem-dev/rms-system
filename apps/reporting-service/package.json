    "typecheck": "tsc --noEmit",
    "test":      "jest"
  },
  "dependencies": {
    "@nestjs/bull":        "^10.0.1",
    "@nestjs/common":      "^10.0.0",
    "@nestjs/config":      "^3.0.0",
