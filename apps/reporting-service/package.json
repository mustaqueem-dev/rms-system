    "@nestjs/platform-express": "^10.0.0",
    "@rms/shared-kernel":  "*",
    "bull":                "^4.16.0",
    "pdfmake":             "^0.2.10",
    "reflect-metadata":    "^0.1.13",
    "rxjs":                "^7.8.1"
  },
  "devDependencies": {
    "@types/bull":         "^4.10.0",
    "@types/node":         "^20.0.0",
    "@types/pdfmake":      "^0.2.9",
    "ts-node":             "^10.9.2",
