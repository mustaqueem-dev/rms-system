# apps/inventory-service/.env.example

NODE_ENV=development
PORT=3002

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=rms_inventory

# Redis (for caching / bullmq if used later)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Auth
JWT_SECRET=change-me-to-a-256-bit-secret-in-production

# Logging
LOG_LEVEL=info
